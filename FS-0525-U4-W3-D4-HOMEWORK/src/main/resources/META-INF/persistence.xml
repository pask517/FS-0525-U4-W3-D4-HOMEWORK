<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.2"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
    <persistence-unit name="FS-0525-U4-W3-D4-HOMEWORKpu">

        <class>andreapascarella.entities.Event</class>
        <class>andreapascarella.entities.Location</class>
        <class>andreapascarella.entities.Participation</class>
        <class>andreapascarella.entities.Person</class>
        <class>andreapascarella.entities.FootballMatch</class>
        <class>andreapascarella.entities.Concert</class>
        <class>andreapascarella.entities.AthleticsCompetition</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/FS-0525-U4-W3-D4-HOMEWORK"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="1234"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>